# คัดลอกเป็นไฟล์ .env ก่อนใช้งาน:  cp .env.example .env
# ค่าด้านล่างใช้ได้กับเครื่องพัฒนาเท่านั้น ห้ามใช้บน server จริง

# ฐานข้อมูล (ตรงกับ docker-compose.yml)
DATABASE_URL="postgresql://hr:hr_dev@localhost:5432/hr"

# ระบบล็อกอิน: บน server จริงให้สร้างใหม่ด้วย  openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
BETTER_AUTH_URL="http://localhost:3000"

# ตัวแปลง HTML เป็น PDF (ตรงกับ docker-compose.yml)
GOTENBERG_URL="http://localhost:3001"

# รหัสผ่านของผู้ใช้ทดสอบที่สร้างจาก seed
SEED_PASSWORD="password123"
